{
  "entities": {
    "Checklist": {
      "title": "Checklist",
      "description": "Represents a customer checklist/project with multiple phases and tasks.",
      "type": "object",
      "properties": {
        "customerName": {
          "type": "string",
          "description": "Name of the customer."
        },
        "phasesData": {
          "type": "string",
          "description": "JSON stringified array of Phase objects containing factors and tasks."
        },
        "status": {
          "type": "string",
          "enum": ["active", "archived"],
          "description": "Current status of the checklist."
        },
        "createdBy": {
          "type": "string",
          "description": "UID of the user who created this checklist."
        },
        "companyDomain": {
          "type": "string",
          "description": "Corporate or custom email domain associated with the creator, to support same-company data sharing (null for public domains)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": ["customerName", "phasesData", "status", "createdBy", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "checklists/{checklistId}": {
      "schema": "Checklist",
      "description": "Collection of customer checklists."
    }
  }
}
