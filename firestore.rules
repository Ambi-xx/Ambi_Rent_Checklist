rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // Global Safety Net
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Helpers
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidChecklist(data) {
      return data.keys().hasAll(['customerName', 'phasesData', 'status', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().size() == 6
        && data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 200
        && data.phasesData is string && data.phasesData.size() <= 1000000 // 1MB total doc limit roughly
        && data.status in ['active', 'archived']
        && data.createdBy is string && data.createdBy == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collections
    // -------------------------------------------------------------------------

    match /checklists/{checklistId} {
      allow get: if isOwner(existing().createdBy);
      allow list: if isSignedIn() && resource.data.createdBy == request.auth.uid;
      
      allow create: if isSignedIn() 
        && isValidChecklist(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
        
      allow update: if isOwner(existing().createdBy)
        && isValidChecklist(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
        
      allow delete: if isOwner(existing().createdBy);
    }
  }
}
